{
  "_comment": "powershell.exe 는 윈도에 언제나 있다. pwsh 7 을 쓰면 그것이 클로드가 보는 자리에 없는 PC 에서 훅이 통째로 죽는다. 훅 스크립트 셋은 5.1 문법만 쓴다.",

  "_form_comment": "command 와 args 를 나눠 적는다. 한 문자열로 적으면 셸이 그것을 다시 가르는데, 사용자 이름에 공백이 든 PC 에서 플러그인 경로가 거기서 깨진다. 나눠 적으면 셸을 안 거치고 그대로 실행된다.",

  "_if_comment": "matcher 는 도구 이름만 거른다. 명령 내용을 거르는 것은 if 다. 이것이 있어야 도커도 python3 도 아닌 명령에서는 프로세스가 아예 안 뜬다. 세션 시작을 가볍게 하는 것이 이 플러그인의 첫째 제약인데, 도구를 부를 때마다 프로세스가 뜨면 그 부담이 자리만 옮긴 꼴이 된다.",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/session-check.ps1"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/docker-cert-reminder.ps1"],
            "if": "Bash(docker *)",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/python3-guard.ps1"],
            "if": "Bash(python3*)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/docker-cert-reminder.ps1"],
            "if": "PowerShell(docker *)",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/python3-guard.ps1"],
            "if": "PowerShell(python3*)",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
