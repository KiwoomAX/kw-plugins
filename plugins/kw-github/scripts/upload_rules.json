{
  "secret": {
    "filename_patterns": [
      {
        "name": "env-file",
        "glob": ".env"
      },
      {
        "name": "env-variant",
        "glob": ".env.*"
      },
      {
        "name": "pem-key",
        "glob": "*.pem"
      },
      {
        "name": "private-key",
        "glob": "*.key"
      }
    ],
    "filename_allow": [
      ".env.example"
    ],
    "content_allow": [
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "uv.lock",
      "poetry.lock",
      "Pipfile.lock"
    ],
    "content_patterns": [
      {
        "name": "private-key-block",
        "regex": "-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----"
      },
      {
        "name": "db-url-with-password",
        "regex": "(?i)\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|oracle|mssql|sqlserver)://[^:/\\s'\\\"]+:[^@/\\s'\\\"]+@"
      },
      {
        "name": "github-token",
        "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,}"
      },
      {
        "name": "llm-api-key",
        "regex": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_\\-]{20,}"
      },
      {
        "name": "google-api-key",
        "regex": "\\bAIza[0-9A-Za-z_\\-]{35}"
      },
      {
        "name": "aws-access-key",
        "regex": "\\bAKIA[0-9A-Z]{16}\\b"
      },
      {
        "name": "password-assignment",
        "regex": "(?i)(?:(?:password|passwd|pwd|secret|api_?key)\\w*|(?<![a-z0-9])(?:access_?|auth_?|api_?)?token\\b)['\\\"]?\\s*[:=]\\s*['\\\"](?![/'\\\"])[^'\\\"\\s]{4,}['\\\"]"
      },
      {
        "name": "login-account",
        "regex": "(?i)\\b(?:(?:user_?name|user_?id|login_?id|account_?id|db_?user)['\\\"]?\\s*[:=]\\s*['\\\"][^'\\\"\\s]{3,}['\\\"]|(?:login|account)['\\\"]?\\s*[:=]\\s*['\\\"](?!/)(?!(?-i:(?=[A-Z0-9_-]*\\d)[A-Z0-9]+(?:[-_][A-Z0-9]+)*)['\\\"])[^'\\\"\\s]{3,}['\\\"])"
      }
    ]
  },
  "data": {
    "extensions": [
      "xlsx",
      "xls",
      "csv",
      "parquet",
      "sqlite",
      "db",
      "pdf",
      "doc",
      "docx",
      "ppt",
      "pptx",
      "hwp",
      "hwpx"
    ],
    "json_allow": [
      "package.json",
      "package-lock.json",
      "tsconfig*.json",
      "jsconfig.json",
      ".vscode/*.json"
    ],
    "json_max_kib": 100,
    "file_max_mib": 10
  }
}
